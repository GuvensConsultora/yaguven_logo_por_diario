<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Mismo ancla que los demás campos que agregamos a la ficha del usuario:
        `other_preferences` es el grupo vacío que la propia vista de Odoo declara
        para que los módulos cuelguen ahí lo suyo.

        El campo es `company_dependent`: lo que se ve acá es la unidad del usuario
        EN LA COMPAÑÍA ACTIVA. Un usuario que trabaja en dos compañías tiene un
        valor en cada una.
    -->
    <record id="view_users_form_unidad_papeleria" model="ir.ui.view">
        <field name="name">res.users.form.unidad.papeleria</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <group name="other_preferences" position="inside">
                <field name="yaguven_unidad_id"
                       options="{'no_create_edit': True}"
                       invisible="share"/>
            </group>
        </field>
    </record>

</odoo>
